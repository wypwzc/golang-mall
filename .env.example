# ============================================================
# go-mall 环境变量模板
# 复制为 .env 后按需修改：cp .env.example .env
# 生产环境务必替换所有 change-me / dev-only 开头的值
# ============================================================

# ---------- 运行环境 ----------
APP_ENV=dev
LOG_LEVEL=info

# ---------- MySQL ----------
# 本地直连本机 MySQL 时 MYSQL_PORT=3306
# 用 docker compose 时容器映射到 3307，MYSQL_PORT 也要改成 3307
MYSQL_HOST_PORT=3307
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# 每个业务库一个独立账号，只授权自己的 schema
USER_DB_PASSWORD=change-me-user-db
PRODUCT_DB_PASSWORD=change-me-product-db
CART_DB_PASSWORD=change-me-cart-db
ORDER_DB_PASSWORD=change-me-order-db
PAYMENT_DB_PASSWORD=change-me-payment-db

# ---------- Redis ----------
# 本地没有 Redis 时设为 false，服务会跳过 Redis（限流退化为内存实现、缓存关闭）
REDIS_ENABLED=false
REDIS_HOST_PORT=6379
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=change-me-redis-password
REDIS_DB=0

# ---------- JWT ----------
# 生产环境必须 >=32 位且不能包含 dev-only，否则服务会拒绝启动
JWT_SECRET=dev-only-change-me-to-a-32-bytes-random-string
JWT_ISSUER=go-mall
JWT_TTL=2h

# ---------- 服务间调用 ----------
INTERNAL_TOKEN=dev-only-internal-token

# ---------- 登录限流 ----------
# 同一账号在 LOGIN_FAIL_WINDOW 内失败超过 LOGIN_MAX_FAILS 次即暂时锁定
LOGIN_MAX_FAILS=5
LOGIN_FAIL_WINDOW=5m

# ---------- 网关上游地址（本地直跑时用） ----------
UPSTREAM_USER=http://127.0.0.1:8081
UPSTREAM_PRODUCT=http://127.0.0.1:8082
UPSTREAM_CART=http://127.0.0.1:8083
UPSTREAM_ORDER=http://127.0.0.1:8084
UPSTREAM_PAYMENT=http://127.0.0.1:8085

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
